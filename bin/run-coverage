#!/usr/bin/env bash
source "$(dirname "$0")/common"
preflight
[[ -f .runtime/installed ]] || fail 'Run ./install.sh first.'
[[ $# == 0 ]] || fail 'This command always runs the full suite. It does not accept spec filters.'
lock_workflow
cleanup() {
    local result=$?
    trap - EXIT
    dc run --rm --no-deps runner rm -f coverage/.active-run >/dev/null 2>&1 || true
    dc stop -t 60 phpfpm >/dev/null 2>&1 || result=1
    dc run --rm --no-deps phpfpm php /application/docker/php/project-hooks.php cleanup || result=1
    dc run --rm --no-deps runner node bin/prepare.cjs --plain >/dev/null || result=1
    dc run --rm --no-deps phpfpm bash /application/docker/php/base-url.sh >/dev/null || result=1
    dc run --rm --no-deps phpfpm bash /application/docker/php/refresh-assets.sh >/dev/null || result=1
    dc start phpfpm >/dev/null 2>&1 || true
    rmdir "$ROOT/.runtime/workflow.lock"
    exit "$result"
}
trap cleanup EXIT
say 'Starting dependencies; draining old PHP requests before clearing artifacts'
dc up -d --wait --wait-timeout 180 db redis opensearch runner
dc stop -t 60 phpfpm
dc run --rm --no-deps phpfpm php /application/docker/php/project-hooks.php cleanup
say 'Creating a new run, disposable template copies, and instrumented JavaScript'
dc run --rm --no-deps runner node bin/prepare.cjs
dc run --rm --no-deps phpfpm php /application/docker/php/project-hooks.php before
dc run --rm --no-deps phpfpm bash /application/docker/php/base-url.sh http://app:8000/
dc up -d phpfpm app
dc exec -T phpfpm bash /application/docker/php/refresh-assets.sh
dc run --rm --no-deps runner node bin/wait-http.cjs
dc exec -T phpfpm php /application/docker/php/project-hooks.php prepare > coverage/project-fixtures.json
dc exec -T --user "$LOCAL_UID:$LOCAL_GID" phpfpm php /application/docker/php/manifest.php
say 'Running the project Cypress suite with all three collectors'
say "Watch Cypress at $(dc exec -T phpfpm bash /application/docker/php/base-url.sh --print-viewer)"
dc exec -T runner node bin/run-browser.cjs
say 'Draining PHP-FPM so all native request exports are complete'
dc stop -t 60 phpfpm
dc run --rm --no-deps --user "$LOCAL_UID:$LOCAL_GID" phpfpm php /application/docker/php/report.php
dc run --rm --no-deps runner node bin/report-browser.cjs
dc run --rm --no-deps runner node bin/finalize.cjs
say 'Open coverage/index.html for the combined report'
